#!/usr/bin/env bash

cat >mise.toml <<'EOF'
[tools]
needs-dummy = { version = "1.0.0", os = ["windows"], runtime_dependencies = ["dummy@1"] }
EOF
assert "MISE_LOCKFILE=1 mise lock --platform windows-x64"
assert_contains "cat mise.lock" 'tools.dummy'

cat >>mise.toml <<'EOF'
dummy = [{ version = "2.0.0", os = ["windows"] }, { version = "1.0.0", os = ["macos", "linux"] }]
EOF
rm mise.lock
assert "MISE_LOCKFILE=1 mise lock needs-dummy --platform windows-x64"
assert_contains "cat mise.lock" 'version = "2.0.0"'
assert_not_contains "cat mise.lock" 'version = "1.1.0"'

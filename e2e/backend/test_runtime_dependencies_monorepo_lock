#!/usr/bin/env bash

cat >mise.toml <<'EOF'
monorepo_root = true
[monorepo]
lockfile = true
config_roots = ["packages/*"]
EOF
mkdir -p packages/app
cat >packages/app/mise.toml <<'EOF'
[tools]
needs-dummy = { version = "1.0.0", runtime_dependencies = ["dummy@1"] }
dummy = "2.0.0"
EOF
assert "MISE_LOCKFILE=1 mise lock needs-dummy"
assert_contains "cat mise.lock" 'tools.dummy'
assert_contains "cat mise.lock" 'version = "2.0.0"'
assert_not_contains "cat mise.lock" 'version = "1.1.0"'
